<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Height="500" Width="800"
        Background="#2D2D30">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

            <TextBox Name="nameBox"
                     Width="150"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"
                     ToolTip="Enter name"/>

            <Button Content="Connect"
                    Width="100"
                    Height="30"
                    Click="ConnectBtn"/>

        </StackPanel>

        <ListBox Grid.Row="1"
                 Name="chatBox"
                 Background="#1E1E1E"
                 Foreground="White"
                 BorderBrush="Gray"
                 FontSize="14"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <TextBox Name="msgBox"
                     Width="600"
                     Height="35"
                     VerticalContentAlignment="Center"
                     ToolTip="Type message"/>

            <Button Content="Send"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="SendBtn"/>

        </StackPanel>

    </Grid>
</Window>