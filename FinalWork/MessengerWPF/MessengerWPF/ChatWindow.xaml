<Window x:Class="MessengerWPF.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger - Чат"
        Height="520" Width="820"
        Background="#0F1115"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#151821"
                CornerRadius="0,12,12,0"
                Padding="10">

            <StackPanel>

                <TextBlock Text="Користувачі"
                           Foreground="#EDEDED"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="10,10,10,15"/>

                <ListBox x:Name="UsersList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">

                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="bg"
                                                Background="#1C2230"
                                                CornerRadius="10"
                                                Padding="10">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#2A3446"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#3A8DFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>

                <TextBlock x:Name="OnlineStatusTextBlock"
                           Text="Онлайн: "
                           Foreground="#B0B3B8"
                           FontSize="14"
                           Margin="10,15,10,0"/>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Background="#0F1115">

                <StackPanel x:Name="MessagesPanel"
                            Margin="15"/>

            </ScrollViewer>

            <Border Grid.Row="1"
                    Background="#151821"
                    CornerRadius="12"
                    Margin="10"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="＋"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="#B0B3B8"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <TextBox x:Name="MessageBox"
                             Grid.Column="1"
                             Background="#1C2230"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="12"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             CaretBrush="White"/>

                    <Button Content="➤"
                            Grid.Column="2"
                            Background="#3A8DFF"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="Send_Click"/>

                </Grid>

            </Border>

        </Grid>
    </Grid>
</Window>