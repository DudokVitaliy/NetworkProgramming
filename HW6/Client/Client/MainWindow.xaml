<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMTP Mail Client"
        Height="500"
        Width="650"
        Background="#1E1E2F"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📧 SMTP MAIL CLIENT"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#2D2D44"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <TextBox Name="emailBox"
                         Width="250"
                         Height="30"
                         Margin="5"
                         Text="Email"
                         Background="#3A3A55"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="5"/>

                <PasswordBox Name="passBox"
                             Width="180"
                             Height="30"
                             Margin="5"
                             Background="#3A3A55"
                             Foreground="White"
                             BorderThickness="0"/>

            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#2D2D44"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <TextBox Name="toBox"
                         Width="250"
                         Height="30"
                         Margin="5"
                         Text="To"
                         Background="#3A3A55"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="5"/>

                <TextBox Name="subjectBox"
                         Width="250"
                         Height="30"
                         Margin="5"
                         Text="Subject"
                         Background="#3A3A55"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="5"/>

            </StackPanel>
        </Border>

        <TextBox Grid.Row="3"
                 Name="bodyBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Background="#2D2D44"
                 Foreground="White"
                 BorderThickness="0"
                 Padding="10"
                 FontSize="14"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <Button Content="📎 Attach file"
                    Width="120"
                    Height="35"
                    Click="AttachBtn"
                    Background="#4444AA"
                    Foreground="White"
                    BorderThickness="0"/>

            <TextBlock Name="fileLabel"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Width="250"/>

            <Button Content="SEND ✉"
                    Width="150"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="SendBtn"
                    Background="#2ECC71"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>

        </StackPanel>

    </Grid>
</Window>